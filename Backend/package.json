{
  "name": "train-tracker-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=.env watch src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:rail-maintenance": "vitest run --config vitest.rail-maintenance.config.ts",
    "test:gtfs-maintenance": "vitest run --config vitest.mainline-gtfs-maintenance.config.ts",
    "test:integration": "RUN_DATABASE_TESTS=true vitest run tests/repository.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "wrangler types --config wrangler.jsonc && tsc -p tsconfig.worker.json --noEmit && tsc -p worker-tests/tsconfig.json --noEmit",
    "typecheck:rail-maintenance": "tsc -p rail-maintenance-tests/tsconfig.json --noEmit",
    "typecheck:gtfs-maintenance": "tsc -p mainline-gtfs-maintenance-tests/tsconfig.json --noEmit",
    "generate:north-american-intercity-gtfs-shapes": "tsx scripts/north-american-intercity-gtfs-compiler.ts",
    "promote:north-american-intercity-gtfs-shapes": "tsx scripts/north-american-intercity-gtfs-compiler.ts --approved-output",
    "audit:north-american-intercity-geometry": "tsx scripts/audit-north-american-intercity-geometry.ts",
    "generate:ntad-amtrak-routes": "tsx scripts/ntad-amtrak-routes-compiler.ts",
    "audit:ntad-amtrak-routes": "tsx scripts/audit-ntad-amtrak-routes.ts",
    "generate:oebb-infotogo-stations": "tsx scripts/generate-oebb-infotogo-stations.ts",
    "generate:tfnsw-platforms": "tsx scripts/generate-tfnsw-platforms.ts",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc",
    "build:denmark-realtime": "node scripts/build-denmark-realtime.mjs",
    "test:denmark-realtime": "WRANGLER_BUILD_CONDITIONS=node WRANGLER_BUILD_PLATFORM=node vitest run --config vitest.denmark-realtime.config.ts"
  },
  "dependencies": {
    "@azure/service-bus": "7.10.0",
    "fastify": "^5.11.0",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "postal-mime": "^2.7.6",
    "zod": "^4.1.5"
  },
  "overrides": {
    "brace-expansion": "2.1.3",
    "find-my-way": "9.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "esbuild": "0.28.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
