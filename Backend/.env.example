PORT=8080
DATABASE_URL=postgres://traintracker:traintracker@localhost:5432/traintracker
DATABASE_SSL=false
LOG_LEVEL=info
WATCHER_ENABLED=true
# Origin of an independently licensed MOTIS instance. An empty value uses the public, noncommercial service.
MOTIS_BASE_URL=
# Comma-separated: amtrak,brightline,via. Only operators with approved bundled data may activate.
NORTH_AMERICAN_INTERCITY_GTFS_GEOMETRY_OPERATORS=via
# Amtrak route lines from the federal NTAD route network (public domain). See docs/decisions/0010.
AMTRAK_NTAD_ROUTE_GEOMETRY_ENABLED=true
APNS_MODE=dry-run
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_IOS_BUNDLE_ID=com.jorgeaguirre.TrainTracker
APNS_MACOS_BUNDLE_ID=com.jorgeaguirre.TrainTracker.mac
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_BASE64=
APNS_PRIVATE_KEY_PATH=
# Optional. Enable only with production publication rights for Japanese timetable data.
EKISPERT_API_KEY=
GOLEMIO_API_KEY=
# Optional. Dedicated Translink Opendata API; falls back to NIR_TIGER_API_KEY when absent.
TRANSLINK_NI_API_TOKEN=
NIR_TIGER_API_KEY=
# Optional. Trafiklab GTFS Sweden 3 Realtime project key.
TRAFIKLAB_GTFS_SWEDEN_RT_API_KEY=
# Optional separate GTFS Regional realtime key: Skåne rail only, quota-gated.
# Requires a fresh compiled station/service index. The separate maintenance
# Worker downloads static data daily; the tracking Worker consumes compact JSON.
TRAFIKLAB_GTFS_REGIONAL_RT_API_KEY=
# Optional. Trafiklab Realtime APIs project key for official platforms, times, cancellations, and alerts.
TRAFIKLAB_REALTIME_API_KEY=

# Optional operator-authorized Chepe schedule. See README and the synthetic schema example.
CHEPE_TIMETABLE_JSON=
